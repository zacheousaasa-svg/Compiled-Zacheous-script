# =====================================================================
# MODULE 2: REPRODUCIBLE DATASET & SUB-THZ CHANNEL GENERATION
# =====================================================================
class TerahertzUrbanCanyonEnv:
    def __init__(self, N=256):
        self.M = NUM_ANTENNAS_BS
        self.N = N
        self.K = NUM_USERS
        self.sigma2 = NOISE_POWER
        
    def _compute_path_loss(self, distance):
        c = 3e8
        lam = c / CARRIER_FREQUENCY
        # Free-space path loss component [Eq. 2]
        fspl_db = 20 * np.log10(4 * np.pi * distance / lam)
        # HITRAN database molecular gas attenuation absorption parameter coefficient [Eq. 2]
        k_f = 0.0045 if RELATIVE_HUMIDITY == 0.50 else 0.001
        absorption_db = 10 * k_f * distance * np.log10(np.e)
        return 10**(-(fspl_db + absorption_db) / 10)

    def generate_channels(self):
        loss_G = self._compute_path_loss(distance=50.0) # BS-to-RIS link
        loss_h = self._compute_path_loss(distance=15.0) # RIS-to-UE link
        
        # Line-of-Sight matrix component geometries [Eq. 1]
        los_G = np.ones((self.N, self.M), dtype=complex)
        los_h = np.ones((self.K, self.N), dtype=complex)
        
        # Non-Line-of-Sight scattering paths matrix [Eq. 3]
        nlos_G = (np.random.randn(self.N, self.M) + 1j * np.random.randn(self.N, self.M)) / np.sqrt(2)
        nlos_h = (np.random.randn(self.K, self.N) + 1j * np.random.randn(self.K, self.N)) / np.sqrt(2)
        
        # Assemble composite Rician fading channel profiles [Eq. 3]
        G = np.sqrt(loss_G) * (np.sqrt(RICIAN_K_FACTOR/(RICIAN_K_FACTOR+1)) * los_G + np.sqrt(1/(RICIAN_K_FACTOR+1)) * nlos_G)
        h = np.sqrt(loss_h) * (np.sqrt(RICIAN_K_FACTOR/(RICIAN_K_FACTOR+1)) * los_h + np.sqrt(1/(RICIAN_K_FACTOR+1)) * nlos_h)
        return G, h

    def compute_sum_rate(self, phase_shifts):
        G, h = self.generate_channels()
        Phi = np.diag(np.exp(1j * phase_shifts)) # Diagonal matrix phase assignment [Eq. 3]
        W = np.ones((self.M, self.K), dtype=complex) * np.sqrt(P_MAX / (self.M * self.K)) # Precoding matching [Eq. 3]
        
        sum_rate = 0.0
        sinrs = []
        for k in range(self.K):
            # Effective complex composite channel vector optimization path [Eq. 3]
            h_eff = h[k, :].conj().T @ Phi @ G
            signal_power = np.abs(h_eff @ W[:, k])**2
            interference_power = sum(np.abs(h_eff @ W[:, i])**2 for i in range(self.K) if i != k)
            
            # Formulate mathematically robust absolute complex squared norm [Eq. 4]
            sinr = signal_power / (interference_power + self.sigma2)
            sinrs.append(sinr)
            sum_rate += np.log2(1 + sinr)
            
        return sum_rate, np.array(sinrs)

# =====================================================================
# MODULE 3: ACTIVE DEEP REINFORCEMENT LEARNING NETWORK (TD3 LOGIC)
# =====================================================================
class ActorNetwork(nn.Module):
    def __init__(self, state_dim, action_dim):
        super(ActorNetwork, self).__init__()
        self.fc1 = nn.Linear(state_dim, 256)
        self.fc2 = nn.Linear(256, 256)
        self.out = nn.Linear(256, action_dim)
        
    def forward(self, state):
        x = torch.relu(self.fc1(state))
        x = torch.relu(self.fc2(x))
        # Continuous bounded activation scaled tightly to the valid phase range [0, 2\pi]
        return torch.tanh(self.out(x)) * np.pi + np.pi

class CriticNetwork(nn.Module):
    def __init__(self, state_dim, action_dim):
        super(CriticNetwork, self).__init__()
        # Dual independent critic paths to evaluate state-action value pairs [Source Fig 2]
        self.fc1 = nn.Linear(state_dim + action_dim, 256)
        self.fc2 = nn.Linear(256, 256)
        self.fc3 = nn.Linear(256, 1)

    def forward(self, state, action):
        x = torch.cat([state, action], dim=1)
        x = torch.relu(self.fc1(x))
        x = torch.relu(self.fc2(x))
        return self.fc3(x)

class ReplayBuffer:
    def __init__(self, max_size=REPLAY_BUFFER_SIZE):
        self.buffer = []
        self.max_size = max_size
        
    def add(self, transition):
        if len(self.buffer) >= self.max_size:
            self.buffer.pop(0)
        self.buffer.append(transition)
        
    def sample(self, batch_size):
        batch = random.sample(self.buffer, batch_size)
        return map(lambda x: torch.FloatTensor(np.array(x)), zip(*batch))

